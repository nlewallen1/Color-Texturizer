<Window x:Class="ColorTexturizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorTexturizer"
        mc:Ignorable="d"
        Icon="/Assets/colorblindlogo.ico"
        Title="Color Texturizer" Height="900" Width="1600"
        Background= "{DynamicResource MaterialDesignPaper}">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <StackPanel
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10">
            <StackPanel.Resources>
                <Style TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignPaperLightButton}">
                    <Setter Property="Width" Value="130" />
                    <Setter Property="Margin" Value="10, 10, 10, 10" />
                </Style>
            </StackPanel.Resources>

            <Button 
                Content="Upload"
                Click="UploadButton_Click"/>
            
            <Button 
                Content="Add texture"
                Click="TextureButton_Click"/>
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="0"
            Margin="20, 0, 0, 20"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">

            <Grid x:Name="ImageContainer">

                <Image x:Name="image"/>

                <Canvas
            x:Name="TextureCanvas"
            IsHitTestVisible="False"/>

            </Grid>
        </ScrollViewer>

        <WrapPanel
            x:Name="ColorPanel"
            Grid.Row="1"
            Grid.Column="1"
            Margin="30"
            
         
        />

    </Grid>

    
</Window>
